{
  "manifest_version": 3,
  "name": "Brand Atlas",
  "version": "0.1.0",
  "description": "Officially published brand assets for the company whose site you're on, and starter brand kits for your own venture.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": [],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
